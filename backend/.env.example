# Environment
ENV=development
TESTING=false

# Database
DATABASE_URL=postgresql://agentic_user:agentic_password@localhost:5435/agentic_platform

# JWT / Auth
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM API keys
GEMINI_API_KEY=your_gemini_api_key

# Redis (recommended for production API key auth cache and distributed rate limiting)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ORIGINS_API=["*"]

# Observability
REQUEST_TIMING_LOG_ENABLED=true
REQUEST_TIMING_LOG_SAMPLE_RATE=0.1
REQUEST_TIMING_LOG_MIN_MS=300

# API key auth/rate-limit performance
API_KEY_AUTH_CACHE_TTL_SECONDS=60
API_KEY_RATE_LIMIT_WINDOW_SECONDS=60

# LLM prompt guardrails
# Set to 0 to disable truncation.
SYSTEM_PROMPT_MAX_CHARS=0

# LLM token budgets (tune based on your use-case)
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_OUTPUT_TOKENS_LONGFORM=2048
TUTOR_MAX_OUTPUT_TOKENS=2048
